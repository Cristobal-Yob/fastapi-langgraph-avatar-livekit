# Generate each secret yourself. Never commit a populated .env.
AGENT_API_TOKEN=
PUBLIC_ORIGIN=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=
MODELO=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.5-flash
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
PORT=8000
