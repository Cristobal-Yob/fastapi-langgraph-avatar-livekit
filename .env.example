STATE_ENCRYPTION_KEY=
AVATAR_ENABLE_PAID=false
AVATAR_ISOLATION_CONFIRMED=false
AVATAR_MAX_SECONDS=100
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
